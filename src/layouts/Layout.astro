---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

import '../styles/global.css';

const { lang, title = 'Pacha Coffee', description } = Astro.props;
const desc = description || t(lang, 'meta.description');

const locales: { code: Lang; href: string }[] = [
  { code: 'es', href: '/' },
  { code: 'en', href: '/en/' },
  { code: 'ja', href: '/ja/' },
];
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  {locales.map(l => <link rel="alternate" hreflang={l.code} href={l.href} />)}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Caveat+Brush&family=DM+Mono:wght@400;500&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,500&display=swap" />
  <style>
    :root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
    html{scroll-padding-top:env(safe-area-inset-top,0px)}
    body{margin:0;padding:0}
    img{max-width:100%}
    [hidden]:not([hidden=until-found i]){display:none!important}
  </style>
</head>
<body>
  <slot />
</body>
</html>
