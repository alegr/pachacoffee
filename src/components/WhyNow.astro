---
import { t } from '../i18n/ui';
import CoffeeBean from './svg/CoffeeBean.astro';

interface Props { lang: string; }
const { lang } = Astro.props;

const cards = [
  { area: 'wa', color: 'var(--oliva)', img: '/images/why-1.jpg', i: 1, beans: [{ r: '-25deg', top: '8%',  left: '6%',  w: '38px' }, { r: '40deg',  top: '62%', right: '5%', w: '32px' }] },
  { area: 'wb', color: 'var(--selva)', img: '/images/why-2.jpg', i: 2, beans: [{ r: '15deg',  top: '10%', right: '8%', w: '34px' }, { r: '-50deg', top: '70%', left: '4%',  w: '30px' }] },
  { area: 'wc', color: 'var(--cafe)',  img: '/images/why-3.jpg', i: 3, beans: [{ r: '30deg',  top: '5%',  left: '8%',  w: '36px' }, { r: '-20deg', top: '55%', right: '6%', w: '28px' }, { r: '60deg', top: '80%', left: '12%', w: '32px' }] },
  { area: 'wd', color: 'var(--ambar)', img: '/images/why-4.jpg', i: 4, beans: [{ r: '-35deg', top: '12%', right: '4%', w: '34px' }, { r: '45deg',  top: '65%', left: '6%',  w: '30px' }] },
  { area: 'we', color: 'var(--bordo)', img: '/images/why-5.jpg', i: 5, beans: [{ r: '20deg',  top: '8%',  left: '5%',  w: '36px' }, { r: '-40deg', top: '58%', right: '7%', w: '32px' }, { r: '55deg', top: '82%', left: '10%', w: '28px' }] },
];
---

<section class="ahora band" id="ahora">
  <div class="wrap why2">
    <div class="why-head reveal">
      <p class="eyebrow"><i class="eb-shape s1" style="--sc:var(--bordo)" aria-hidden="true"></i><i class="eb-dots" aria-hidden="true"></i>{t(lang, 'whynow.eyebrow')}</p>
      <h2 class="h2" set:html={t(lang, 'whynow.title').replace(/\s/, '<br>')} />
      <p class="why-sub">{t(lang, 'whynow.lead')}</p>
      <a class="btn" href="https://wa.me/5493513515559?text=Hola!%20Quiero%20trabajar%20con%20Pacha%20Coffee%20%F0%9F%91%8B" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
        {t(lang, 'whynow.cta')}
      </a>
    </div>

    {cards.map((card) => (
      <article class={`wcard ${card.area}`} tabindex="0" style={`--c:${card.color}`}>
        <span class="wbeans" aria-hidden="true">
          {card.beans.map((b) => (
            <CoffeeBean class="wbean" style={`--r:${b.r};top:${b.top};${b.left ? `left:${b.left}` : `right:${b.right}`};width:${b.w}`} />
          ))}
        </span>
        <span class="wph" aria-hidden="true"><img src={card.img} alt=""></span>
        <span class="go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8"/></svg></span>
        <div class="wbody">
          <span class="wtag">{t(lang, `whynow.card${card.i}tag`)}</span>
          <h3>{t(lang, `whynow.card${card.i}title`)}</h3>
          <div class="wexp">
            <p class="ghost">{t(lang, `whynow.card${card.i}desc`)}</p>
            <p class="typed" aria-hidden="true"></p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
