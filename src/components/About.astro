---
import { t } from '../i18n/ui';

interface Props { lang: string; }
const { lang } = Astro.props;
---

<section id="nosotros" aria-label="Quiénes somos">
  <div class="wrap about">
    <div class="bento stagger">
      <article class="bx bx--cafe" data-tilt>
        <svg class="deco" viewBox="0 0 100 130" aria-hidden="true"><ellipse cx="50" cy="65" rx="44" ry="60"/><path d="M50 8 C 22 40, 78 86, 50 122" fill="none" stroke="#4C280F" stroke-width="9" stroke-linecap="round" style="fill:none"/></svg>
        <span class="kick"><i class="eb-shape s1" style="--sc:#F2D9AE" aria-hidden="true"></i><i class="eb-dots" aria-hidden="true"></i>{t(lang, 'about.eyebrow1')}</span>
        <h3 set:html={t(lang, 'about.title1')} />
        <p>{t(lang, 'about.desc1')}</p>
      </article>
      <article class="bx bx--ambar" data-tilt>
        <svg class="deco" viewBox="-4 -6 140 202" aria-hidden="true"><path d="M68.78,169.3s0,.03,0,.04v5.87c0,1.24.55,5.13.93,6.38,1.45,4.9,5.73,6.22,10.35,7.11,8.06,1.56,19.18,1.87,27.49,2.16,1.84.06,11.6-.28,14.22.17.39.07.54.54.26.83-.11.12-.22.2-.25.2H10.46c-.46,0-.67-.59-.3-.87.11-.09.25-.17.4-.28,4.91-3.74,20.9-5.45,27.17-5.36,5.58.08,16.03,2.64,20.77.9,6.14-2.26,6.52-8.36,7.03-14.09.14-1.59.5-5.09.43-6.48-.16-3.13-1.76-5.16-1.21-9.32.18-1.37.7-2.51,1.3-3.58,1.45-2.56,1.42-5.7-.02-8.26s-3.32-5.23-3.71-8.55c-.47-4.09,1.69-7.93,1.98-12.15.45-6.48-1.51-14.75-4.79-20.38-2.95-5.06-4.63-2.98-9.62-3.38-14.12-1.14-26.75-6.79-35.94-17.68-4.48-5.31-7.08-13.23-13.82-16.04-.7-.73,1.68-1.26,2.05-1.39,18.44-6.58,48.24-.26,55.83,19.68,2.67,7.01.82,11.44,5.66,18.32.34.48.01.99,1.05.76-.13-.75-.41-1.43-.42-2.21-.22-10.11,1.45-29.51-5.09-37.57-1.82-2.24-7.03-3.26-9.94-4.68-15.51-7.59-27.72-23.39-29.99-40.69-.79-6.03-.07-12.37-2.55-18.08-.15-.34.13-.71.49-.68,19.64,1.91,41.68,17.46,46.16,37.22.71,3.15,1.39,7.64,1.37,10.85-.02,3.82-1.76,9.61-1.55,12.88.18,2.82,2.63,6.72,3.38,10.26.11.5.8.52.94.04l2.59-8.76c.01-.05.02-.1.02-.16-.14-4.71-.65-9.11-.08-13.82,2.95-24.37,27.33-39.96,50.62-40.06.38,0,.62.43.41.75-5.1,7.85-4.96,17.25-8.77,25.93-5.18,11.81-16.15,22.28-28.11,27.14-2.61,1.06-6.8,1.56-8.82,2.56s-3.85,6.74-4.47,8.94c-1.62,5.75-1.96,11.82-2.16,17.74s.12,11.65.06,17.46c0,.5.65.68.91.25l4.36-7.39c.03-.05.05-.11.06-.16,2.45-14.88,12.75-26.11,27.04-30.54,9.07-2.81,19.39-3.61,28.67-1.4.41.1.52.62.18.87-5.89,4.25-8.36,11.2-12.42,16.96-8.46,11.97-19.88,17.59-34.42,18.8-1.9.16-5.75-.44-7.24.33-.07.03-.12.08-.16.14-2.82,3.68-4.6,8.35-5.67,12.86-1.2,5.08-2.51,13.82-1.66,18.87.23,1.37,1.03,2.89,1.77,4.48,1.16,2.5,1.33,5.37.36,7.94-2.14,5.66-2.38,11.87-1.83,18.32ZM59.96,58.12c.29.46.99.19.9-.34-.86-5.16-3.38-10.06-5.9-14.59-5.55-9.98-14.68-21.72-23.94-28.46-.55-.4-.84-.76-1.64-.59,10.28,9.48,17.92,20.95,24.85,33.03,1.98,3.45,3.7,7.73,5.73,10.93,0,0,0,0,0,.01ZM103.45,21.93c.44-.41-.11-1.1-.61-.76-.26.18-.5.35-.72.51-9.58,6.88-24.67,23.94-28.17,35.2-.11.35-1,2.81-.09,2.75s8.29-12.81,9.62-14.74c5.79-8.37,12.59-15.98,19.97-22.95ZM54.02,93.7c.45.38,1.06-.21.7-.68-8.56-10.96-22.13-18.57-35.5-21.6-.21,1.08.23.71.81.99,9.59,4.73,19.4,8.64,27.58,15.91l6.41,5.38ZM109.98,78.36c.51-.28.19-1.05-.38-.9-.84.24-1.65.55-2.45.85-9.1,3.4-20.18,11.62-26.61,18.89-.35.39-1.92,2.18-2.76,3.44-.33.5.35,1.03.76.6.06-.06.12-.12.18-.17,7.41-6.16,14.13-13.11,22.67-17.95l8.58-4.76Z"/></svg>
        <span class="kick"><i class="eb-shape s3" style="--sc:#F2D9AE" aria-hidden="true"></i><i class="eb-dots" aria-hidden="true"></i>{t(lang, 'about.eyebrow2')}</span>
        <h3 set:html={t(lang, 'about.title2')} />
        <p>{t(lang, 'about.desc2')}</p>
      </article>
      <article class="bx bx--tostado" data-tilt>
        <div class="bxl">
          <div class="txt">
            <span class="kick"><i class="eb-shape s2" style="--sc:#F2D9AE" aria-hidden="true"></i><i class="eb-dots" aria-hidden="true"></i>{t(lang, 'about.eyebrow3')}</span>
            <h3 set:html={t(lang, 'about.title3')} />
            <p>{t(lang, 'about.desc3')}</p>
          </div>
          <ul class="flow">
            <li><b class="no">01</b><span class="ic"><svg viewBox="0 0 24 24"><path d="M12 21V11"/><path d="M12 13c-4 0-6-3-6-6 4 0 6 3 6 6z"/><path d="M12 11c0-4 2-7 6-7 0 4-2 7-6 7z"/><path d="M7 21h10"/></svg></span><span>{t(lang, 'about.flow1')}<small>{t(lang, 'about.flow1sub')}</small></span></li>
            <li><b class="no">02</b><span class="ic"><svg viewBox="0 0 24 24"><path d="M9 4h6l1 3H8z"/><path d="M6 7h12v13H6z"/><path d="M9 12l2 2 4-4"/></svg></span><span>{t(lang, 'about.flow2')}<small>{t(lang, 'about.flow2sub')}</small></span></li>
            <li><b class="no">03</b><span class="ic"><svg viewBox="0 0 24 24"><circle cx="9" cy="14" r="5.5"/><circle cx="15.5" cy="9" r="4.5"/><path d="M9 11.5v5"/></svg></span><span>{t(lang, 'about.flow3')}<small>{t(lang, 'about.flow3sub')}</small></span></li>
          </ul>
        </div>
        <figure class="bxph"><img src="/images/community.jpg" alt="" loading="lazy" /></figure>
      </article>
    </div>
  </div>
  <div class="wrap wrap--full">
    <div class="services stagger" id="servicios">
      <div class="svc">
        <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M20 42h24l-3 16H23z"/><path d="M32 42V22"/><path d="M32 30c-8 0-13-5-14-12 8 0 13 5 14 12z"/><path d="M32 24c1-8 6-13 14-13-1 8-6 13-14 13z"/></svg>
        <h3>{t(lang, 'services.s1title')}</h3>
        <p>{t(lang, 'services.s1desc')}</p>
      </div>
      <div class="svc">
        <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32 58V14"/><path d="M32 22c-6-2-9-7-8-12 6 1 9 6 8 12z"/><path d="M32 34c6-2 10-7 9-13-6 1-10 6-9 13z"/><path d="M32 46c-6-2-10-7-9-13 6 1 10 6 9 13z"/><circle cx="20" cy="50" r="3.5"/><circle cx="44" cy="44" r="3.5"/><circle cx="43" cy="54" r="3.5"/></svg>
        <h3>{t(lang, 'services.s2title')}</h3>
        <p>{t(lang, 'services.s2desc')}</p>
      </div>
      <div class="svc">
        <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M8 18h48l-4 8H12z"/><path d="M14 26h36v20H14z"/><path d="M26 26v20M38 26v20"/><circle cx="20" cy="52" r="5"/><circle cx="44" cy="52" r="5"/><path d="M24 10h16v8H24z"/></svg>
        <h3>{t(lang, 'services.s3title')}</h3>
        <p>{t(lang, 'services.s3desc')}</p>
      </div>
      <div class="svc">
        <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M16 14h32l4 44H12z"/><path d="M16 14l4-6h24l4 6"/><circle cx="32" cy="36" r="9"/><path d="M28 36l3 3 6-6"/></svg>
        <h3>{t(lang, 'services.s4title')}</h3>
        <p>{t(lang, 'services.s4desc')}</p>
      </div>
    </div>
  </div>
</section>
